# ==============================================================================
# AutoAudit - Environment Variables
# ==============================================================================

PORT=3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration (100% Free Tier)
# 1. Sign up / log in to https://supabase.com
# 2. Click "New Project" (choose any free region)
# 3. Go to Project Settings -> API
# 4. Copy "Project URL" into SUPABASE_URL / VITE_SUPABASE_URL
# 5. Copy "anon / public" key into SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY
# 6. Run the SQL script from /supabase/schema.sql in the Supabase SQL Editor
# ------------------------------------------------------------------------------

# Client-side access (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend server access (Express / Node.js)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=
