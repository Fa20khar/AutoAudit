# ==============================================================================
# AutoAudit - Environment Variables Template (.env.example)
# Use this template to configure environment variables for local dev and Railway.
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# ==============================================================================
# 1. PRIMARY APPLICATION DATABASE — MONGODB ATLAS (Backend ONLY)
# Used as the primary operational store for Orders, Services, Coupons, Emails,
# Customer Intake Submissions, Contact Analytics, and Referrals.
#
# Format:
# MONGODB_URI=mongodb+srv://<database-user>:<password>@<actual-atlas-host>/autoaudit_db?retryWrites=true&w=majority
#
# DO NOT put MONGODB_URI in a VITE_ variable or expose it to the React browser bundle.
# ==============================================================================

MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>.mongodb.net/autoaudit_db?retryWrites=true&w=majority

# ==============================================================================
# 2. FRONTEND ENVIRONMENT VARIABLES (Client-side / Vite)
# Note: Variables prefixed with VITE_ are bundled into client code.
# NEVER put private server secrets, database passwords, or service-role keys here.
# ==============================================================================

# Google Forms Public Respondent Embed URL (AutoAudit Report Request Form)
VITE_GOOGLE_FORMS_EMBED_URL=https://docs.google.com/forms/d/1BI-BkUJyXoQKSNUT3GaU30Z2p9m0_cypwDeVP9VTfeU/viewform?embedded=true

# Railway Backend URL (Required when frontend is hosted separately on Vercel)
# Leave blank or omit when running locally or hosting frontend+backend together on Railway
# Example: https://autoaudit-production.up.railway.app
VITE_API_BASE_URL=https://your-railway-app.up.railway.app

# ==============================================================================
# 3. BACKEND SERVER & SECURITY (Server-side / Node.js / Express)
# These variables remain strictly on the backend and are NEVER exposed to browsers.
# ==============================================================================

# Server Network Port (Railway injects $PORT automatically; defaults to 3000)
PORT=3000

# Node Environment (development | production)
NODE_ENV=production

# Cryptographic JWT Secret for signing staff administrator sessions
# Generate a random 64-character hex string (e.g. using `openssl rand -hex 32`)
# Required in production; minimum 32 characters.
JWT_SECRET=your-random-64-character-jwt-secret-key-change-this-in-production

# One-Time Admin Setup Secret
# Used once to provision the initial root administrator account via /api/auth/setup-admin
# Once the root admin is created in MongoDB, the setup endpoint permanently locks.
ADMIN_SETUP_SECRET=your-secure-one-time-admin-setup-secret-token

# Optional: Initial Root Admin Seed (Alternative to one-time setup endpoint)
# If set, automatically provisions the root admin document in MongoDB on first boot
ADMIN_EMAIL=admin@autoaudit.com
ADMIN_INITIAL_PASSWORD=replace-with-your-strong-root-password

# ==============================================================================
# 4. EMAIL / SMTP DISPATCH CONFIGURATION (Optional)
# If SMTP_HOST is unset, AutoAudit automatically operates in built-in Mock SMTP mode
# with instant zero-latency simulated delivery and an in-app outbox inspector.
# ==============================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Set to your verified domain sender address when using live SMTP (e.g. "AutoAudit <noreply@yourdomain.com>")
# When unset in mock mode, defaults to "AutoAudit Notifications <noreply@autoaudit.local>"
SMTP_FROM=
