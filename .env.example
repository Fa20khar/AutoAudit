# ==============================================================================
# AutoAudit - Environment Variables Template (.env.example)
# Use this template to configure environment variables for local dev and Railway.
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Client-side / Vite)
# Note: Variables prefixed with VITE_ are bundled into client code.
# NEVER put private server secrets, database passwords, or service-role keys here.
# ==============================================================================

# Supabase Project URL (Client Access)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous / Public API Key (Client Access, protected by PostgreSQL RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# 2. BACKEND SERVER ENVIRONMENT VARIABLES (Server-side / Node.js / Express)
# These variables remain strictly on the backend and are NEVER exposed to browsers.
# ==============================================================================

# Server Network Port (Railway injects $PORT automatically; defaults to 3000)
PORT=3000

# Node Environment (development | production)
NODE_ENV=production

# Supabase Project URL (Backend Access)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (Backend fallback)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Backend ONLY — bypasses RLS for administrative operations)
# Leave blank to operate using Anon Key with RLS policies, or provide service-role key for backend operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ==============================================================================
# 3. ADMINISTRATIVE OPERATIONS CONSOLE CREDENTIALS
# Used to authenticate staff at /admin for managing orders and report dispatches.
# ==============================================================================

ADMIN_EMAIL=admin@autoaudit.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SECRET_KEY=your-secret-staff-bearer-token

# ==============================================================================
# 4. EMAIL / SMTP DISPATCH CONFIGURATION (Optional)
# If SMTP_HOST is unset, AutoAudit automatically operates in built-in Mock SMTP mode
# with instant zero-latency simulated delivery and an in-app outbox inspector.
# ==============================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AutoAudit Notifications <noreply@autoaudit.intelligence>"
